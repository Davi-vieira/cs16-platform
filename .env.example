# .env.example — Servidor Vieira-STRIKE
# Copie este arquivo para .env no servidor e defina senhas fortes e únicas.
# NUNCA comite o arquivo .env preenchido no controle de versão.

# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_DB=cs16
POSTGRES_USER=cs16_admin
POSTGRES_PASSWORD=defina_uma_senha_forte_para_admin_aqui

# Conexão do backend (usuário da aplicação com permissões específicas)
DATABASE_URL_BACKEND=postgresql+asyncpg://cs16_backend:defina_senha_backend@postgres:5432/cs16

# ==========================================
# Segurança do Backend (FastAPI)
# ==========================================
# Gere uma chave de 64 caracteres hexadecimais: openssl rand -hex 32
SECRET_KEY=gere_uma_chave_secreta_aleatoria_longa_e_segura

# Segredo de validação de webhooks do provedor de pagamento (PIX)
PAYMENT_WEBHOOK_SECRET=segredo_fornecido_pelo_gateway_de_pagamento

# Domínio público ou IP para CORS e FastDL
SERVER_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Servidor CS 1.6 (Vieira-STRIKE)
# ==========================================
SERVER_HOSTNAME="Vieira-STRIKE"
RCON_PASSWORD=defina_uma_senha_rcon_segura_aqui

# FastDL público (servido pelo Nginx)
FASTDL_URL=http://SEU_IP_OU_DOMINIO/fastdl
